<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="BodyShapeLabWindow.uss" />
  <ui:ScrollView class="panel">
    <ui:Label text="Humanoid Body Shape Modifier v0.1 · Doggy Lab" class="title" />
    <ui:Label text="16 Kawaii clips × Original / Light / Medium / Strong. All four copies share the same animation time. Source clips and Riggle assets are unchanged." class="note" />
    <ui:VisualElement class="row"><ui:Button name="open" text="Open comparison scene" /><ui:Button name="build" text="Build / rebuild lab" /></ui:VisualElement>
    <ui:DropdownField name="animation" label="Animation" />
    <ui:Toggle name="focus" label="Show this row only" value="true" />
    <ui:VisualElement class="row"><ui:Button name="previous" text="Previous animation" /><ui:Button name="next" text="Next animation" /></ui:VisualElement>
    <ui:VisualElement class="row"><ui:Button name="play" text="Play / pause" /><ui:Button name="restart" text="Restart clip" /><ui:Button name="frame" text="Frame row in Scene" /></ui:VisualElement>
    <ui:Slider name="phase" label="Scrub pose" low-value="0" high-value="1" value="0.35" show-input-field="true" />
    <ui:Slider name="speed" label="Playback speed" low-value="0.1" high-value="2" value="1" show-input-field="true" />
    <ui:VisualElement class="row"><ui:Button name="profile" text="Select body-shape profile" /><ui:Button name="audit" text="Run 16-clip overlap audit" /></ui:VisualElement>
    <ui:Foldout text="Bake adjusted clips" value="true">
      <ui:DropdownField name="bakeLevel" label="Correction level" />
      <ui:IntegerField name="bakeFps" label="Samples per second" value="60" />
      <ui:Toggle name="bakeSmooth" label="Include smooth blending" value="true" />
      <ui:VisualElement class="row"><ui:Button name="bakeCurrent" text="Bake this animation" /><ui:Button name="bakeAll" text="Bake all 16 animations" /></ui:VisualElement>
      <ui:Label text="Creates new character-specific clips and a playback prefab. Use that prefab or the same skeleton with Animator Avatar=None. Hip motion is included; the character stays in place. Exit Play Mode to bake." class="note" />
      <ui:Label name="bakeResult" class="note" />
    </ui:Foldout>
    <ui:Label name="metrics" class="metrics" />
    <ui:Label text="The measurements use fitted torso and shoe volumes, not exact mesh collisions. Strong corrections can change gestures; deliberate hand-on-hip and crossed-leg poses use reduced correction. Edit arm/foot weights on a sample to tune a clip. Floor clearance assumes a flat floor." class="note" />
  </ui:ScrollView>
</ui:UXML>
