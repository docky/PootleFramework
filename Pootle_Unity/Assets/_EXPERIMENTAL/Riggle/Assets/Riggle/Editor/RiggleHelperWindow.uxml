<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="RiggleHelperWindow.uss" />
  <ui:VisualElement name="helperRoot" class="rig-helper">
    <ui:Label text="Riggle · Rig Helper" class="helper-title" />
    <ui:Label text="A guided path from your model to a reusable, tested character." class="helper-subtitle" />
    <ui:VisualElement name="steps" class="step-row" />
    <ui:Label name="characterName" class="copy" />
    <ui:ScrollView name="body" class="helper-body" />
    <ui:Label name="message" class="helper-message" />
    <ui:VisualElement name="footer" class="helper-footer" />
  </ui:VisualElement>
</ui:UXML>
